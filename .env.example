# Reisevær settings. Copy to .env and fill in.

# REQUIRED by MET Norway's terms: contact information (email address or website) that is sent
# in the User-Agent header with every weather request, so MET can reach you if something is wrong.
# The app does not fetch weather until this is set.
MET_CONTACT=

PORT=3200
NODE_ENV=development

# Requests per IP per 10 minutes to the app's own API (protects the free services we use).
RATE_LIMIT=60

# Routing service (OSRM-compatible). Default: FOSSGIS server based on OpenStreetMap.
ROUTING_URL=https://routing.openstreetmap.de/routed-car

# Advertisement (Google AdSense).
# ADS_ENABLED=true with no IDs shows a preview box only (to judge the placement).
# ADSENSE_CLIENT = your publisher ID (ca-pub-…): adds the site-verification tag and /ads.txt.
# ADSENSE_SLOT   = the ad unit's ID (digits) from AdSense → Ads → By ad unit. With both IDs the ad goes live.
# ADSENSE_TEST   = true shows Google test ads (default: true unless NODE_ENV=production).
ADS_ENABLED=false
ADSENSE_CLIENT=
ADSENSE_SLOT=
